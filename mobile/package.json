  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p .",
    "parity": "tsx tests/parity/indicators.test.ts && tsx tests/parity/scanners.test.ts && tsx tests/parity/strategies.test.ts && tsx tests/parity/models.test.ts && tsx tests/parity/ensemble.test.ts && tsx tests/parity/trading.test.ts && tsx tests/parity/evaluator.test.ts",
    "proxy": "node scripts/dev-proxy.js",
    "apk": "eas build -p android --profile preview",
    "ota": "expo export --platform android --output-dir dist --dump-assetmap --max-workers 1 && eas update --channel preview --environment preview --platform android --skip-bundler --input-dir dist --message"
